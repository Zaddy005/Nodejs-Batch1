<!DOCTYPE html>
<html>
<%- include('./layout/head.ejs')  %>
<body>
<h1>Welcome to EJS Lesson</h1>

<%- include('./layout/nav.ejs') %>

<div class="content" >
<% if(post){ %>
        <div>
            <h3> <%= post.title %> </h3>
            <p> <%= post.createdAt ? new Date(post.createdAt).toLocaleString() : "unknow Date" %> </p>
            <h5> <%= post.subtitle%> </h5>
            <hr/>
            <p> <%= post.body %> </p>

            <div style="display: flex;align-items: center;" >
                <a href="/" class="btn"  >Back</a>
                <a href="/posts/<%= post["_id"] %>/edit " class="btn" >Edit</a>
                <form class="padding:0;margin:0;" action="/post/<%= post["_id"] %>/delete" method="POST">
                    <button type="submit" class="btn" style="background: red;border: none;"
                            onclick="window.alert('are you sure you want to delete this post')"
                    >Delete</button>
                </form>
            </div>

        </div>

<% }else{ %>
        <p> There are no blog posts to display</p>
        <a href="/posts/create" >Create First Post</a>
    <% } %>

</div>

<%- include('./layout/footer.ejs') %>

</body>
</html>